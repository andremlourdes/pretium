# Copie para .env (ou configure no seu secret manager/CI) antes do deploy em produção.
# Security profile explícito para runtime de produção.
SPRING_PROFILES_ACTIVE=prod,security

# Database
PRETIUM_DB_URL=jdbc:postgresql://postgres:5432/pretium
PRETIUM_DB_USERNAME=pretium
PRETIUM_DB_PASSWORD=change-this-db-password

POSTGRES_DB=pretium
POSTGRES_USER=pretium
POSTGRES_PASSWORD=change-this-postgres-password

# JWT
# Gere um segredo forte de no mínimo 32 bytes.
PRETIUM_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes

# App
PORT=8080

